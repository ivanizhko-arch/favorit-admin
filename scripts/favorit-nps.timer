[Unit]
Description=Запуск разбора оценок клиентов каждые 10 минут

[Timer]
# Первый прогон через минуту после загрузки, дальше каждые 10 минут.
# Недовольный клиент попадает в контроль качества в течение этого окна;
# месячный отчёт уходит на первом прогоне первого числа.
OnBootSec=1min
OnUnitActiveSec=10min
# Пропущенные за время простоя сервера прогоны не копятся — достаточно
# одного: воркер идемпотентен и сам разберёт всё накопившееся.
Persistent=false
AccuracySec=1min

[Install]
WantedBy=timers.target
