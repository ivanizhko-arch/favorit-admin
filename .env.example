# Скопируй в .env и заполни своими значениями.
# .env не коммитится (в .gitignore).

# JWT secret — используется для админ-токенов.
# На проде должен совпадать с SECRET_KEY основного backend, чтобы токены
# были совместимы, если понадобится (сейчас не критично — админ токены
# валидируются только этим сервисом).
SECRET_KEY=devsecret_change_me_in_prod

# Пароль от админ-панели. В проде — сложный, в .env главного backend
# должен быть тот же.
ADMIN_PASSWORD=admin123

# Двухфакторка (TOTP). Пусто → вход только по паролю, как раньше.
# Секрет генерируется: python scripts/gen_totp.py
# На проде заполнить обязательно — админка управляет персональными данными.
ADMIN_TOTP_SECRET=
ADMIN_TOTP_ISSUER=Фаворит · Админ

# Защита от подбора пароля: после N неудач с одного IP вход блокируется
# на M секунд.
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_LOCKOUT_SECONDS=300

# Путь к SQLite. Локально — favorit.db в текущей директории. На проде —
# абсолютный путь к базе основного сервиса.
DB_PATH=favorit.db

# CORS — откуда браузеры могут стучаться в /admin.
CORS_ORIGINS=http://localhost:8001,http://127.0.0.1:8001,https://app.favorit-consult.ru

# Режим разработки — если true, коды подтверждения и пр. видны в ответе.
# На проде false.
DEBUG=true

# ---- Контроль качества по оценкам клиентов ----
# Входящий вебхук Битрикс24. Нужен для задач контроля качества и месячного
# отчёта. Создаётся в Битриксе: Разработчикам → Другое → Входящий вебхук.
# Права: crm (чтение), task (создание). Пусто → задачи не создаются,
# события только пишутся в лог, сервис работает.
BITRIX_WEBHOOK_URL=

# ID сотрудников, на которых уходят задачи. Смотреть в профиле:
# https://<портал>.bitrix24.ru/company/personal/user/<ID>/
BITRIX_QC_HEAD_ID=0        # руководитель отдела контроля качества
BITRIX_SUPPORT_HEAD_ID=0   # руководитель отдела сопровождения
BITRIX_CEO_ID=0            # генеральный директор

# Градация оценок: 0-6 — в контроль качества, 9-10 — лучшие, идут в рейтинг
# менеджеров, 7-8 — нейтральные. Совпадает с классическими границами NPS.
# Итог менеджера = количество лучших минус количество низких.
QC_DETRACTOR_MAX=6
QC_PROMOTER_MIN=9

# Дедлайн задачи по низкой оценке (часов) и защита от залпа задач при
# первом запуске на накопленной базе.
QC_TASK_DEADLINE_HOURS=24
QC_TASK_MAX_AGE_DAYS=7

# С какого числа месяца отправляется отчёт за прошлый месяц.
MONTHLY_REPORT_DAY=1
