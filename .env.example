# Скопируй в .env и заполни своими значениями.
# .env не коммитится (в .gitignore).

# JWT secret — используется для админ-токенов.
# На проде должен совпадать с SECRET_KEY основного backend, чтобы токены
# были совместимы, если понадобится (сейчас не критично — админ токены
# валидируются только этим сервисом).
SECRET_KEY=devsecret_change_me_in_prod

# Пароль от админ-панели. В проде — сложный, в .env главного backend
# должен быть тот же.
ADMIN_PASSWORD=admin123

# Двухфакторка (TOTP). Пусто → вход только по паролю, как раньше.
# Секрет генерируется: python scripts/gen_totp.py
# На проде заполнить обязательно — админка управляет персональными данными.
ADMIN_TOTP_SECRET=
ADMIN_TOTP_ISSUER=Фаворит · Админ

# Защита от подбора пароля: после N неудач с одного IP вход блокируется
# на M секунд.
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_LOCKOUT_SECONDS=300

# Путь к SQLite. Локально — favorit.db в текущей директории. На проде —
# абсолютный путь к базе основного сервиса.
DB_PATH=favorit.db

# CORS — откуда браузеры могут стучаться в /admin.
CORS_ORIGINS=http://localhost:8001,http://127.0.0.1:8001,https://app.favorit-consult.ru

# Режим разработки — если true, коды подтверждения и пр. видны в ответе.
# На проде false.
DEBUG=true

# ---- Контроль качества по оценкам клиентов ----
# Входящий вебхук Битрикс24. Нужен для задач контроля качества и месячного
# отчёта. Создаётся в Битриксе: Разработчикам → Другое → Входящий вебхук.
# Права: crm (чтение), task (создание). Пусто → задачи не создаются,
# события только пишутся в лог, сервис работает.
BITRIX_WEBHOOK_URL=

# ID сотрудников, на которых уходят задачи. Смотреть в профиле:
# https://<портал>.bitrix24.ru/company/personal/user/<ID>/
BITRIX_QC_HEAD_ID=0        # руководитель отдела контроля качества
BITRIX_SUPPORT_HEAD_ID=0   # руководитель отдела сопровождения
BITRIX_CEO_ID=0            # генеральный директор

# Градация оценок: 0-7 — в контроль качества, 9-10 — лучшие, идут в рейтинг
# менеджеров, 8 — нейтральная. Итог менеджера = лучшие минус низкие.
# Подписи диапазонов в админке строятся из этих чисел, править их больше
# нигде не нужно.
QC_DETRACTOR_MAX=7
QC_PROMOTER_MIN=9

# Дедлайн задачи по низкой оценке (часов) и защита от залпа задач при
# первом запуске на накопленной базе.
QC_TASK_DEADLINE_HOURS=24
QC_TASK_MAX_AGE_DAYS=7

# С какого числа месяца отправляется отчёт за прошлый месяц.
MONTHLY_REPORT_DAY=1

# ---- Стадии банкротства ----
# Направление сделок «БФЛ. Сопровождение».
BANKRUPTCY_CATEGORY_ID=15

# Стадия, означающая завершение дела: «Долг списан», а не закрытие сделки.
STAGE_DONE_ID=C15:UC_UJI8T9
# Стадии после списания — дело закончено, сделка доводится до закрытия.
STAGE_SUCCESS_IDS=C15:WON

# Служебные стадии: не этап работы. В воронку и средние сроки не входят.
# C15:NEW — тех.этап, C15:UC_HN6K2D — «Клиенты от Гараджи» (признак источника).
STAGE_SERVICE_IDS=C15:NEW,C15:UC_HN6K2D

# Ожидание и простой: дело стоит не потому, что идёт работа.
# Оставлено без движения, Заседание отложено, Пауза.
STAGE_STUCK_IDS=C15:UC_7ICUJ1,C15:PREPARATION,C15:UC_ZTR9AW

# Провальные исходы — из среднего срока дела исключаются.
STAGE_FAILED_IDS=C15:PREPAYMENT_INVOIC,C15:EXECUTING,C15:LOSE

# Взаимоисключающие процедуры: клиент проходит одну, не обе.
STAGE_ALTERNATIVE_IDS=C15:UC_LWCW5Y,C15:UC_3UFLUY

# Как часто обновлять снимок сделок и сколько тянуть за прогон.
STAGE_SYNC_MIN_INTERVAL_MINUTES=60
STAGE_SYNC_MAX_DEALS=2000

# ---- Отдел сопровождения: отказы и зависшие дела ----
# Код поля сделки в Битриксе с причиной отказа, если оно уже ведётся
# (например UF_CRM_1712345678). Пусто → причина заполняется в админке.
BITRIX_REFUSAL_REASON_FIELD=

# Дело считается зависшим, если стоит на стадии дольше нормы. Норма своя
# у каждой стадии: медиана её прохождения, умноженная на коэффициент.
STUCK_FACTOR=2.0
# Нижняя граница, чтобы не дёргать руководителя из-за трёх дней.
STUCK_MIN_DAYS=14
# Когда завершённых прохождений мало, медиане верить нельзя — берём это.
STUCK_DEFAULT_DAYS=45
# Сколько задач-перехватов ставить за один прогон воркера.
STUCK_ALERT_BATCH=20

# ---- Кого показывать в таблице менеджеров ----
# Уволенных и роботов скрываем по умолчанию.
MANAGER_HIDE_INACTIVE=true
MANAGER_HIDE_NON_EMPLOYEES=true
# Подстрока в должности, без учёта регистра. Пусто → должность не проверяется.
# Посмотреть, как должности записаны у вас, можно в колонке «Должность».
MANAGER_POSITION_CONTAINS=
# Либо фильтр по отделам — ID через запятую.
MANAGER_DEPARTMENT_IDS=
# Явные исключения по ID: учётки вроде «Робот Фаворит», заведённые обычными
# сотрудниками и потому не отсеиваемые по типу.
MANAGER_EXCLUDE_IDS=

# ---- Жалобы клиентов ----
# Общий секрет для служебного эндпоинта, через который основной backend
# передаёт жалобы. То же значение пропиши в .env основного сервиса.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Пусто → эндпоинт отдаёт 503, а не принимает жалобы от кого угодно.
INTERNAL_API_TOKEN=

# Срок ответа клиенту — 10 дней по Закону о защите прав потребителей.
# Менять только вместе с юристом: просрочка даёт право на неустойку.
COMPLAINT_ANSWER_DAYS=10
# Внутренний дедлайн задачи, рабочих дней. Короче срока ответа намеренно.
COMPLAINT_TASK_DEADLINE_WORKDAYS=3

# Предохранители от потока. Основное ограничение — одна открытая жалоба
# на тему, оно в коде; эти числа лишь против скриптов.
COMPLAINT_MAX_PER_DAY=3
COMPLAINT_MAX_PER_MONTH=10
COMPLAINT_COOLDOWN_SECONDS=300
